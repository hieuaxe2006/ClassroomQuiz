# EditorConfig for ClassroomQuiz
# https://editorconfig.org

root = true

# Default for all files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# files
[*.cs]
indent_size = 4

# Unity YAML files (scenes, prefabs, assets)
[*.{unity,prefab,asset,mat,controller,anim,overrideController,physicMaterial,physicsMaterial2D,playable,mask,flare,fontsettings,guiskin,giparams,renderTexture,spriteatlas,brush,terrainlayer,signal}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# XML / csproj
[*.{xml,csproj,props,targets}]
indent_size = 2
